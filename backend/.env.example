# ─── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Auth ─────────────────────────────────────────────────────
# REQUIRED: Replace with a random 32+ character secret in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING_HERE
JWT_EXPIRES_IN=8h

# ─── Database ─────────────────────────────────────────────────
# Path to the SQLite database file. Created automatically on first run.
DB_PATH=./data/queuedigially.db

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development: http://localhost:3000
# Production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────
# Window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info

# ─── External (Future) ────────────────────────────────────────
# GEMINI_API_KEY=
# APP_URL=http://localhost:3000
